# ==============================================================================
# ENVIRONMENT VARIABLES FOR PRODUCTION & VERCEL DEPLOYMENT
# ==============================================================================
# Add these environment variables in your Vercel Project Settings -> Environment Variables.
#
# VITE_SUPABASE_URL: Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
# VITE_SUPABASE_ANON_KEY: Your Supabase Project Anon API key

VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
